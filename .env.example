# Copiar a .env (que esta en .gitignore) y rellenar.
# Ningun valor real debe entrar nunca a git.

# Raiz del data lake. Fuera del repositorio y fuera de carpetas
# sincronizadas con la nube (iCloud/Drive): el churn de sincronizacion
# sobre parquet de varios GB es un problema real.
FINVEX_DATA_ROOT=~/finvex-data

# Raiz de las corridas de experimentos.
FINVEX_RUNS_ROOT=./runs

# --- Proveedores de datos (opcionales, segun a cual se tenga acceso) ---
# WRDS / OptionMetrics
WRDS_USERNAME=
WRDS_PASSWORD=

# LSEG / Refinitiv Workspace (sesion de escritorio)
LSEG_APP_KEY=

# Massive (ex Polygon)
MASSIVE_API_KEY=
